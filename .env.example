# Бэкенд данных: firebase (по умолчанию) | appwrite
# Пока в проде и dev оставляйте firebase — Appwrite готовится отдельно.
DATA_BACKEND=firebase

# --- Appwrite (когда переключите DATA_BACKEND=appwrite) ---
# APPWRITE_ENDPOINT=http://localhost/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_DATABASE_ID=print_shop

# --- Playwright E2E (optional; enables authenticated scenarios) ---
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_PORT=3000
