# Appwrite Console → Settings → API Keys → Create API key (scopes: databases, collections)
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key_with_databases_write

# Имя базы (создаётся скриптом, если нет)
APPWRITE_DATABASE_ID=print_shop
APPWRITE_DATABASE_NAME=Print Shop
