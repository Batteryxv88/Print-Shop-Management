{
  "name": "job",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --env port=3000",
    "build:prod": "webpack --env mode=production",
    "build:dev": "webpack --env mode=development",
    "dev": "webpack",
    "predeploy": "npm run build:prod && node -e \"require('fs').writeFileSync('build/.nojekyll','')\"",
    "deploy": "node -e \"require('gh-pages/lib/index.js').clean()\" && gh-pages -d build -r https://github.com/Batteryxv88/Print-Shop-Management.git",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-smoke --project=mobile-chrome --project=tablet-chrome",
    "test:e2e:shell": "playwright test --project=mobile-authenticated --project=tablet-authenticated",
    "test:e2e:stock": "playwright test --project=mobile-authenticated e2e/mobile/stock.spec.ts",
    "test:e2e:journal": "playwright test --project=mobile-authenticated e2e/mobile/journal.spec.ts",
    "test:e2e:tablet-stock": "playwright test --project=tablet-authenticated e2e/tablet/stock.spec.ts",
    "test:e2e:analytics": "playwright test --project=mobile-authenticated e2e/mobile/analytics.spec.ts --project=tablet-authenticated e2e/tablet/analytics.spec.ts",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:tablet": "playwright test --project=tablet-chrome",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://batteryxv88.github.io/Print-Shop-Management",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.35",
    "@types/react-dom": "^18.2.14",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "@types/webpack": "^5.28.4",
    "@types/webpack-dev-server": "^4.7.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "css-loader": "^6.8.1",
    "file-loader": "^6.2.0",
    "gh-pages": "^6.1.0",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.7.6",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.18.0",
    "sass": "^1.105.2",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "url-loader": "^4.1.1",
    "vitest": "^4.1.12",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "buffer": "^6.0.3",
    "chartsheet": "^0.3.1",
    "classnames": "^2.5.1",
    "firebase": "^10.7.1",
    "react": "^18.2.0",
    "react-csv": "^2.2.2",
    "react-data-export": "^0.6.0",
    "react-dom": "^18.2.0",
    "react-favicon": "^2.0.3",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.49.3",
    "react-intersection-observer": "^9.5.3",
    "react-query": "^3.39.3",
    "react-redux": "^8.1.3",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  }
}
