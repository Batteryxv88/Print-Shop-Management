{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "ESNext",
        "target": "es5",
        "jsx": "react-jsx",
        "allowJs": true,
        "moduleResolution": "node",
        //"baseUrl": ".",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "typeRoots": ["./node_modules/@types", "./src/types"]
    },
    "include": [
        "src/**/*",
        "css-modules.d.ts"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/test",
        "e2e"
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}
